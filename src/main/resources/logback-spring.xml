<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Properties from Spring -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="learning-management-system"/>
    <springProperty scope="context" name="appVersion" source="spring.application.version" defaultValue="0.1.0"/>

    <!-- Common Properties -->
    <property name="LOG_PATTERN_PLAIN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [${appName}] [${appVersion}] %-5level %logger{36} - %msg%n"/>

    <!-- ========================================== -->
    <!-- LOCAL PROFILE - Plain Text Format         -->
    <!-- ========================================== -->
    <springProfile name="default | dev | dev-postgres | prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN_PLAIN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/lms-application.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/lms-application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>10MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN_PLAIN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <logger name="com.lms.mentoring" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>

        <logger name="org.springframework" level="INFO"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

    <!-- ========================================== -->
    <!-- CLOUD PROFILE - JSON Format for SAP BTP   -->
    <!-- ========================================== -->
    <springProfile name="cloud">
        <!-- 
            SAP Application Logging Service expects specific field names:
            - msg: the log message
            - level: log level (INFO, WARN, ERROR)
            - logger: logger name
            - written_at: timestamp
            Using pattern-based JSON for SAP Kibana compatibility
        -->
        <appender name="CONSOLE_SAP" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- SAP Application Logging field mappings -->
                <fieldNames>
                    <timestamp>written_at</timestamp>
                    <message>msg</message>
                    <logger>logger</logger>
                    <level>level</level>
                    <thread>thread</thread>
                    <stackTrace>stacktrace</stackTrace>
                </fieldNames>
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
                <timeZone>UTC</timeZone>
                <!-- Include MDC values for correlation -->
                <includeMdc>true</includeMdc>
                <!-- Include caller info for debugging -->
                <includeCallerData>false</includeCallerData>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_SAP"/>
        </root>

        <logger name="com.lms.mentoring" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE_SAP"/>
        </logger>

        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="com.sap.cloud" level="WARN"/>
        <logger name="com.sap.cloud.sdk" level="WARN"/>
    </springProfile>

</configuration>