{
  "instance_min_count": 1,
  "instance_max_count": 3,
  "scaling_rules": [
    {
      "metric_type": "cpu",
      "breach_duration_secs": 60,
      "threshold": 80,
      "operator": ">=",
      "cool_down_secs": 120,
      "adjustment": "+1"
    },
    {
      "metric_type": "cpu",
      "breach_duration_secs": 60,
      "threshold": 20,
      "operator": "<",
      "cool_down_secs": 120,
      "adjustment": "-1"
    },
    {
      "metric_type": "memoryused",
      "breach_duration_secs": 60,
      "threshold": 85,
      "operator": ">=",
      "cool_down_secs": 120,
      "adjustment": "+1"
    },
    {
      "metric_type": "responsetime",
      "breach_duration_secs": 120,
      "threshold": 2000,
      "operator": ">=",
      "cool_down_secs": 180,
      "adjustment": "+1"
    }
  ],
  "schedules": {
    "timezone": "Europe/Warsaw",
    "recurring_schedule": []
  }
}