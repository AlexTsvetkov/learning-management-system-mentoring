		{
			"name": "SAP BTP - Destination Service",
			"item": [
				{
					"name": "Get OAuth Token (Destination)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"destination_access_token\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{destination_clientid}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{destination_clientsecret}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{destination_token_url}}/oauth/token",
							"host": [
								"{{destination_token_url}}"
							],
							"path": [
								"oauth",
								"token"
							]
						},
						"description": "Gets an OAuth2 access token for Destination Service API calls. The token is automatically saved to environment variable 'destination_access_token'.\n\nRequired environment variables:\n- destination_clientid: from VCAP_SERVICES\n- destination_clientsecret: from VCAP_SERVICES\n- destination_token_url: from VCAP_SERVICES (url field)"
					},
					"response": []
				},
				{
					"name": "List All Destinations",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{destination_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{destination_uri}}/destination-configuration/v1/destinations",
							"host": [
								"{{destination_uri}}"
							],
							"path": [
								"destination-configuration",
								"v1",
								"destinations"
							]
						},
						"description": "Lists all destinations configured in the subaccount/service instance.\n\nRequires:\n- destination_access_token (from 'Get OAuth Token' request)\n- destination_uri: from VCAP_SERVICES"
					},
					"response": []
				},
				{
					"name": "Get Destination by Name",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{destination_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{destination_uri}}/destination-configuration/v1/destinations/{{destination_name}}",
							"host": [
								"{{destination_uri}}"
							],
							"path": [
								"destination-configuration",
								"v1",
								"destinations",
								"{{destination_name}}"
							]
						},
						"description": "Gets a specific destination configuration by name.\n\nRequires:\n- destination_access_token (from 'Get OAuth Token' request)\n- destination_uri: from VCAP_SERVICES\n- destination_name: name of the destination (e.g., 'lms-smtp')"
					},
					"response": []
				},
				{
					"name": "Find Destination",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{destination_access_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{destination_uri}}/destination-configuration/v1/subaccountDestinations/{{destination_name}}",
							"host": [
								"{{destination_uri}}"
							],
							"path": [
								"destination-configuration",
								"v1",
								"subaccountDestinations",
								"{{destination_name}}"
							]
						},
						"description": "Finds a destination at subaccount level.\n\nRequires:\n- destination_access_token (from 'Get OAuth Token' request)\n- destination_uri: from VCAP_SERVICES\n- destination_name: name of the destination"
					},
					"response": []
				}
			],
			"description": "SAP BTP Destination Service API requests. Used to manage and retrieve destination configurations.\n\nTo use these requests:\n1. Get VCAP_SERVICES credentials from CF app: cf env learning-management-system\n2. Set environment variables from destination service binding:\n   - destination_clientid\n   - destination_clientsecret\n   - destination_token_url\n   - destination_uri\n3. First run 'Get OAuth Token' to obtain access_token\n4. Then use other requests with the token"
		},
		{
			"name": "SAP BTP - Feature Flags Service",
			"item": [
				{
					"name": "Get OAuth Token (Feature Flags)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"ff_access_token\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
